# tab5_player - M5Stack Tab5 (ESP32-P4 rev 1.x, 16 MB flash, 32 MB PSRAM) + ESP32-C6 over SDIO (esp_hosted 1.4.0).
# Chip revision, flash, partition table, bootloader and esp_hosted settings are the same as in the firmware this
# example comes from, so its image boots on the same bootloader and fits the same OTA slots.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# A bootloader built from this project also rolls back an unconfirmed OTA image (the app never confirms itself).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SPI_FLASH_SUPPORT_GD_CHIP=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM: LE Audio host state lives in PSRAM (EXT_RAM_NOINIT_ATTR), thread stacks too.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=6144
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# FAT on the SD card: long names, UTF-8
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# esp_hosted host: ESP32-C6 on SDIO slot 1, 4-bit, 40 MHz, reset on GPIO15 (Tab5 wiring)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=13
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=12
CONFIG_ESP_HOSTED_SDIO_PIN_D0=11
CONFIG_ESP_HOSTED_SDIO_PRIV_PIN_D1_4BIT_BUS=10
CONFIG_ESP_HOSTED_SDIO_PIN_D2=9
CONFIG_ESP_HOSTED_SDIO_PIN_D3=8
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=10
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=20
CONFIG_ESP_HOSTED_PKT_STATS=y

# FAT on the SD card (patched fatfs: exFAT): buffers in PSRAM, fast seek
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_PER_FILE_CACHE=y

# Display (M5Stack Tab5 BSP + LVGL 9.2.2), as in the original firmware: RGB565, I2C at 100 kHz
CONFIG_BSP_I2C_FAST_MODE=n
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_DEMO_WIDGETS=n

# Cyberdeck: codec through the new I2C driver (i2c_master) - the legacy driver next to the new one aborts at start-up
# ("i2c: CONFLICT! driver_ng is not allowed to be used with this old driver")
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set
